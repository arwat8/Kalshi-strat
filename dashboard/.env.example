# --- Browser (baked in at build time; never put secrets here) ---
# Public repo only: read data straight from raw.githubusercontent.com.
# Leave empty on Vercel with a private repo: the app then uses /api/data (below).
VITE_DATA_BASE=
# Set to 1 to always show the demo data (useful for screenshots).
VITE_FORCE_MOCK=

# --- Vercel serverless proxy (/api/data), server-side only ---
# Fine-grained token: repository access = arwat8/Kalshi-strat only, permission Contents: Read-only.
GITHUB_TOKEN=
GITHUB_REPO=arwat8/Kalshi-strat
GITHUB_BRANCH=main
